#!/usr/bin/env bash
# Render the real card offscreen. Never connect to or capture a live desktop.
set -euo pipefail
repo=$(realpath "$(dirname "${BASH_SOURCE[0]}")/..")
omarchy=${OMARCHY_PATH:-/usr/share/omarchy}
[[ -d $omarchy/shell/Commons && -d $omarchy/shell/Ui ]] || {
  printf 'Omarchy Quattro Shell modules are required.\n' >&2; exit 1;
}
stage=$(mktemp -d)
trap 'rm -rf -- "$stage"' EXIT
mkdir -p "$stage/home" "$repo/docs"
ln -s "$omarchy/shell/Commons" "$stage/Commons"
ln -s "$omarchy/shell/Ui" "$stage/Ui"
ln -s "$repo" "$stage/plugin"
cp "$repo/scripts/Preview.qml" "$stage/shell.qml"

for kind in short long; do
  output="$repo/preview.png"
  [[ $kind == long ]] && output="$repo/docs/long-command.png"
  env -u WAYLAND_DISPLAY -u DISPLAY -u HYPRLAND_INSTANCE_SIGNATURE \
    HOME="$stage/home" XDG_CONFIG_HOME="$stage/home/.config" \
    QT_QPA_PLATFORM=offscreen QT_QPA_PLATFORMTHEME= QT_STYLE_OVERRIDE=Fusion \
    QT_QUICK_BACKEND=software QSG_RENDER_LOOP=basic \
    ASKPASS_PREVIEW_KIND="$kind" ASKPASS_PREVIEW_OUTPUT="$output" \
    timeout 15s qs -n -p "$stage"
  [[ -s $output ]]
  printf 'Rendered %s\n' "$output"
done
